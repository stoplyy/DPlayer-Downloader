{
  "manifest_version": 3,
  "name": "Frame Video Downloader",
  "version": "0.1.0",
  "description": "Find and download media from the active tab through a local downloader.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {"default_title": "Frame 视频下载器", "default_popup": "popup.html"},
  "background": {"service_worker": "service_worker.js", "type": "module"}
}
